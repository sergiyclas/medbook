# Copy to .env and adjust. Every value has a working default for local demo use.

# PostgreSQL (docker compose)
POSTGRES_USER=medbook
POSTGRES_PASSWORD=medbook
POSTGRES_DB=medbook
# Host port; 5433 avoids clashing with a locally installed PostgreSQL
POSTGRES_PORT=5433

# Used when the backend runs on the host (uv run uvicorn ...);
# inside docker compose it is overridden to point at the db container.
DATABASE_URL=postgresql+psycopg://medbook:medbook@localhost:5433/medbook

# Must be a long random string outside local demo use
# JWT_SECRET=

# ---------- Notifications ----------
# console – reminders are only printed in the worker log (default, nothing leaves the system)
# live    – real e-mail (SMTP) and SMS (Twilio); every variable below is required
NOTIFICATION_MODE=console

# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional, e.g. "MedBook <you@gmail.com>"; defaults to SMTP_USERNAME
MAIL_FROM=

# Twilio console: Account SID, Auth Token and the number Twilio gave you (E.164).
# A trial account only delivers to phone numbers you have verified in the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
