@startuml er-diagram
' Database schema (PostgreSQL), generated by Alembic from app/models.
!include style.iuml
skinparam linetype ortho
hide circle

entity users {
  * id : integer <<PK>>
  --
  * email : varchar(255) <<unique>>
  * password_hash : varchar(255)
  * role : varchar(20)
  * is_active : boolean
  * created_at : timestamptz
}
entity patients {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK, unique>>
  * last_name, first_name : varchar(100)
  middle_name : varchar(100)
  * phone : varchar(20)
  * birth_date : date
  * notify_email, notify_sms : boolean
  * created_at : timestamptz
}
entity doctors {
  * id : integer <<PK>>
  --
  * user_id : integer <<FK, unique>>
  * specialization_id : integer <<FK>>
  * last_name, first_name : varchar(100)
  middle_name, room, bio
  * slot_minutes : integer
  * is_active : boolean
}
entity specializations {
  * id : integer <<PK>>
  --
  * name : varchar(100) <<unique>>
  description : text
}
entity working_hours {
  * id : integer <<PK>>
  --
  * doctor_id : integer <<FK>>
  * weekday : integer (0–6)
  * start_time, end_time : time
}
entity days_off {
  * id : integer <<PK>>
  --
  * doctor_id : integer <<FK>>
  * day : date
  reason : varchar(200)
  <<unique (doctor_id, day)>>
}
entity appointments {
  * id : integer <<PK>>
  --
  * patient_id : integer <<FK>>
  * doctor_id : integer <<FK>>
  * starts_at, ends_at : timestamptz
  * status : varchar(20)
  reason : varchar(500)
  doctor_notes : text
  * created_at : timestamptz
  <<unique (doctor_id, starts_at)\nWHERE status IN (scheduled, confirmed)>>
}
entity appointment_status_changes {
  * id : integer <<PK>>
  --
  * appointment_id : integer <<FK>>
  from_status : varchar(20)
  * to_status : varchar(20)
  changed_by_id : integer <<FK>>
  reason : varchar(500)
  * changed_at : timestamptz
}
entity notifications {
  * id : integer <<PK>>
  --
  * appointment_id : integer <<FK>>
  * channel, kind, status : varchar(20)
  * send_at : timestamptz
  * attempts : integer
  last_error : varchar(500)
  claimed_at, sent_at : timestamptz
  <<unique (appointment_id, kind, channel)\nWHERE status IN (pending, sending)>>
}
entity clinic_settings {
  * id : integer <<PK, = 1>>
  --
  * reminder_email_hours_before : integer
  * reminder_sms_hours_before : integer
  * max_daily_bookings_per_patient : integer
  * booking_horizon_days : integer
  * patient_cancel_cutoff_hours : integer
}

users ||--o| patients
users ||--o| doctors
specializations ||--o{ doctors
doctors ||--o{ working_hours
doctors ||--o{ days_off
patients ||--o{ appointments
doctors ||--o{ appointments
appointments ||--o{ appointment_status_changes
users |o--o{ appointment_status_changes
appointments ||--o{ notifications
@enduml
