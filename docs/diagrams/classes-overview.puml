' Members are shown in the zoomed-in diagrams (classes-*.puml).
!include style.iuml
skinparam linetype polyline
left to right direction
skinparam nodesep 25
skinparam ranksep 45
!include model.iuml
hide members
hide <<dataclass>> stereotype
